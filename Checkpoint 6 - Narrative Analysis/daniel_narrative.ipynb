     ]
    }
   ],
   "source": [
    "print(countries.groupby(\"regime_2010\")[\"net_change\"].agg(\n",
    "    median_net_change=\"median\", share_declined=lambda s: (s < 0).mean()).reindex(REGIMES).round(3))\n",
    "\n",
    "big = changes[(changes[\"regime_previous\"] == \"Hybrid regime\") & (changes[\"abs_change\"] >= 0.5)]\n",
    "print(f\"\\nOne-year moves of 0.5+ points while hybrid: {len(big)}, of which declines: {(big['score_change'] < 0).sum()}\")\n",
    "print(big.sort_values(\"score_change\")[[\"country_name\", \"year\", \"score_change\"]].head(8).to_string(index=False))\n",
    "\n",
    "share_big = changes.groupby(\"regime_previous\")[\"abs_change\"].apply(lambda s: (s >= 0.5).mean()).reindex(REGIMES)\n",
    "print(\"\\nShare of one-year changes that are 0.5+ points, by regime that year:\")\n",
    "print((100 * share_big).round(1))"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "43ce2902",
   "metadata": {},
   "source": [
    "## 3. Trying to break the finding\n",
    "\n",
    "Alternative explanations, and the check run against each:\n",
    "\n",
    "1. **A few coups or revolutions drive it.** Drop every country with any single one-year move of 1.5+ points, then redo the comparison.\n",
    "2. **2020 and 2021 pandemic scoring.** EIU marked down civil liberties during lockdowns. Drop those two years.\n",
    "3. **It depends on the time window.** Split into 2011-2016 and 2017-2022.\n",
    "4. **It's just the middle of the scale.** Hybrid is the 4-6 band, so it has room to move both ways, while full democracies sit near the 10 ceiling. Look at variation by 2010 score instead of regime label, and compare hybrid with flawed democracies, the other mid-scale group."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "d907ea9b",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-11-16T00:08:09.120427Z",
     "iopub.status.busy": "2026-11-16T00:08:09.120230Z",
     "iopub.status.idle": "2026-11-16T00:08:09.206410Z",
     "shell.execute_reply": "2026-11-16T00:08:09.205956Z"
    }
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Shock countries dropped: ['Afghanistan', 'Fiji', 'Libya', 'Myanmar', 'Thailand', 'Tunisia']\n",
      "                         Authoritarian  Hybrid regime  Flawed democracy  Full democracy  p vs Authoritarian  p vs Flawed democracy  p vs all others\n",
      "check                                                                                                                                              \n",
      "all years (main result)          0.112          0.150             0.096           0.063               0.054                  0.001            0.000\n",
      "drop shock countries             0.111          0.150             0.095           0.063               0.006                  0.001            0.000\n",
      "drop 2020 and 2021               0.112          0.132             0.080           0.056               0.139                  0.001            0.000\n",
      "2011-2016 only                   0.085          0.110             0.080           0.038               0.707                  0.039            0.024\n",
      "2017-2022 only                   0.092          0.148             0.100           0.077               0.005                  0.007            0.000\n"
     ]
    }
   ],
   "source": [
    "def compare(df, label):\n",
    "    c = by_country(df)\n",
    "    h = c.loc[c[\"regime_2010\"] == \"Hybrid regime\", \"mean_abs_change\"]\n",
    "    row = {\"check\": label}\n",
    "    for regime in REGIMES:\n",
    "        row[regime] = c.loc[c[\"regime_2010\"] == regime, \"mean_abs_change\"].median()\n",
    "    for regime in [\"Authoritarian\", \"Flawed democracy\"]:\n",
    "        row[f\"p vs {regime}\"] = stats.mannwhitneyu(h, c.loc[c[\"regime_2010\"] == regime, \"mean_abs_change\"],\n",
    "                                                   alternative=\"two-sided\").pvalue\n",
    "    row[\"p vs all others\"] = stats.mannwhitneyu(h, c.loc[c[\"regime_2010\"] != \"Hybrid regime\", \"mean_abs_change\"],\n",
    "                                                alternative=\"two-sided\").pvalue\n",
    "    return row\n",
    "\n",
    "\n",
    "shock_countries = changes.groupby(\"country_code\")[\"abs_change\"].max().loc[lambda s: s >= 1.5].index\n",
    "print(\"Shock countries dropped:\", sorted(changes.loc[changes[\"country_code\"].isin(shock_countries), \"country_name\"].unique()))\n",
    "\n",
    "checks = pd.DataFrame([\n",
    "    compare(changes, \"all years (main result)\"),\n",
    "    compare(changes[~changes[\"country_code\"].isin(shock_countries)], \"drop shock countries\"),\n",
    "    compare(changes[~changes[\"year\"].isin([2020, 2021])], \"drop 2020 and 2021\"),\n",
    "    compare(changes[changes[\"year\"] <= 2016], \"2011-2016 only\"),\n",
    "    compare(changes[changes[\"year\"] >= 2017], \"2017-2022 only\"),\n",
    "]).set_index(\"check\")\n",
    "with pd.option_context(\"display.width\", 200):\n",
    "    print(checks.round(3))"
   ]
  },
